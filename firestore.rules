rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      match /wordProgress/{wordId} {
        allow read, write: if isOwner(userId) && isValidId(wordId);
      }

      match /dialogueProgress/{dialogueId} {
        allow read, write: if isOwner(userId) && isValidId(dialogueId);
      }

      match /dailyStats/{dateId} {
        allow read, write: if isOwner(userId) && isValidId(dateId);
      }
    }
  }
}
